          },
          {
            "type": "narration",
            "character": "Narrator",
            "text": "Minh bước tới bên cạnh, ánh mắt đầy quyết tâm. Minh đáp"
          },
          {
            "type": "dialogue",
            "character": "Minh",
            "text": "Cháu đã chuẩn bị xong toàn bộ lưới và lương thực rồi ông ạ."
          },
          {
            "type": "narration",
            "character": "Narrator",
            "text": "Từ trên boong tàu, Lan vẫy tay gọi lớn"
