          {
            "type": "narration",
            "character": "Narrator",
            "text": "Buổi sáng trên bến cảng sương còn đọng trên những mũi thuyền."
          },
          {
            "type": "narration",
            "character": "Narrator",
            "text": "Ông lão nhìn ra biển khơi rồi chậm rãi nói"
